{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipei Cut",
  "version": "0.1.1",
  "identifier": "br.com.clipeistudiodigital.clipeicut",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Clipei Cut",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "backgroundColor": "#0a0a0d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' blob: asset: http://asset.localhost; connect-src 'self' https://*.supabase.co ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; font-src 'self' data: asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Clipei Studio Digital",
    "category": "Video",
    "shortDescription": "Clipes automáticos com IA para criadores",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "PortugueseBR",
          "English",
          "Spanish"
        ],
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerIcon": "installer/installer.ico"
      }
    },
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/fonts/*": "fonts/"
    },
    "copyright": "© Clipei Studio Digital",
    "homepage": "https://clipeistudiodigital.com.br/",
    "longDescription": "Clipei Cut transforma lives, gameplays e podcasts em clipes verticais com legenda, usando IA. O vídeo é processado no seu computador."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY1NTQ4M0FDMjVCOTQ4MTIKUldRU1NMa2xySU5VOVlZelRqZFVCalZNaTNjWG0wekdzYmoyZlJjQ3RZMldmditWcGRwUGlUUm8K",
      "endpoints": [
        "https://github.com/HonBrasil/clipei-cut/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
